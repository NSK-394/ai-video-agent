# ─── AI Video Agent — Environment Configuration ───────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# ─── DaVinci Resolve Scripting ────────────────────────────────────────────
# Path to the Resolve scripting API directory.
# Windows default (used automatically if not set):
RESOLVE_SCRIPT_API=C:\ProgramData\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting

# macOS default (uncomment and adjust if needed):
# RESOLVE_SCRIPT_API=/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting

# ─── Optional: AI / Cloud Services ───────────────────────────────────────
# Required only if you use cloud-based transcription or MCP integration.
# Leave blank to use local Whisper instead.
# OPENAI_API_KEY=sk-...

# ─── Logging ──────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Whisper ──────────────────────────────────────────────────────────────
# Default model size used when --whisper-model is not specified.
# tiny | base | small | medium | large
# (base recommended: ~150 MB, good accuracy/speed balance)
WHISPER_MODEL=base
