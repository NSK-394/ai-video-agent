# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ─── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# ─── Environment secrets ───────────────────────────────────────────────────
.env
# Keep the example file
!.env.example

# ─── Build / distribution ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
site/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ─── Testing / type checking ───────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# ─── IDEs ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
ai_editor.log

# ─── Media assets (large binary files) ────────────────────────────────────
assets/clips/
assets/music/
assets/fonts/
assets/overlays/
assets/sfx/
!assets/**/.gitkeep

# Common video formats
*.mp4
*.mov
*.avi
*.mkv
*.mxf
*.m4v
*.r3d
*.braw
*.webm

# Common audio formats
*.wav
*.mp3
*.aac
*.flac
*.m4a
*.ogg

# ─── Reference / output directories ───────────────────────────────────────
reference/demo_videos/
reference/extracted_data/
!reference/**/.gitkeep

output/rendered/
output/temp/
output/captions/
!output/**/.gitkeep

# ─── Whisper model cache ───────────────────────────────────────────────────
# Default Whisper model download location
~/.cache/whisper/
*.pt

# ─── DaVinci Resolve cache ────────────────────────────────────────────────
*.drp
*.resolve
CacheClip/
Proxy/

# ─── Temp / system files ──────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Jupyter ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Node (if any frontend tooling is added) ──────────────────────────────
node_modules/
npm-debug.log*
